   DEBUG: 2026-04-16 15:40:44,945:      pdf_renderer.py:  470: printSegment: │   ├── therapist.db           # SQLite database (auto-created)
   DEBUG: 2026-04-16 15:40:44,947:      pdf_renderer.py:  470: printSegment: │   ├── libs/                  # Question library JSONs
   DEBUG: 2026-04-16 15:40:44,949:      pdf_renderer.py:  470: printSegment: │   ├── q_tables/              # Persisted RL Q-tables per subject
   DEBUG: 2026-04-16 15:40:44,950:      pdf_renderer.py:  470: printSegment: │   ├── results/               # Session reports and notes CSVs
   DEBUG: 2026-04-16 15:40:44,952:      pdf_renderer.py:  470: printSegment: │   └── logs/                  # Per-user session logs (CSV + JSON)
   DEBUG: 2026-04-16 15:40:44,954:      pdf_renderer.py:  470: printSegment: │
   DEBUG: 2026-04-16 15:40:44,956:      pdf_renderer.py:  470: printSegment: ├── assets/                    # Static assets
