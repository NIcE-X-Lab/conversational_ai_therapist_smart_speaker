   DEBUG: 2026-04-16 15:40:43,782:      pdf_renderer.py:  470: printSegment: │
   DEBUG: 2026-04-16 15:40:43,783:      pdf_renderer.py:  470: printSegment: └── utils/                     # Shared utilities
   DEBUG: 2026-04-16 15:40:43,784:      pdf_renderer.py:  470: printSegment:     ├── config_loader.py       # YAML + .env config aggregator
   DEBUG: 2026-04-16 15:40:43,787:      pdf_renderer.py:  470: printSegment:     ├── inference_guard.py     # Heavy-inference serialization lock,
