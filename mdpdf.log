   DEBUG: 2026-04-16 15:40:44,936:      pdf_renderer.py:  470: printSegment: ├── models/                    # Model weights
   DEBUG: 2026-04-16 15:40:44,939:      pdf_renderer.py:  470: printSegment: │   ├── litert/                # Gemma 4 E2B LiteRT model (.litertlm)
   DEBUG: 2026-04-16 15:40:44,941:      pdf_renderer.py:  470: printSegment: │   └── piper/                 # Piper TTS voice model (.onnx)
   DEBUG: 2026-04-16 15:40:44,942:      pdf_renderer.py:  470: printSegment: │
